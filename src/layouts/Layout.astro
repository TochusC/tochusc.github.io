---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Zuyao Xu is a master’s student in cyberspace security at Nankai University. His research focuses on Internet infrastructure security, Internet measurement, and AI agent security.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
