---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.svelte';
import WorkDetail from '../../components/WorkDetail.svelte';
import { projectDetails } from '../../lib/portfolio';
import { projects } from '../../lib/projects';
export function getStaticPaths() {
  return projectDetails.map(detail => ({params:{slug:detail.slug},props:{detail,project:projects.find(p => p.repo === detail.repo)}}));
}
const { detail, project } = Astro.props;
if (!project) throw new Error(`Missing project metadata: ${detail.slug}`);
---
<Layout title={`${project.name} | Zuyao Xu`} description={detail.summary.en}>
  <div class="mx-auto max-w-[1600px] px-5 sm:px-8"><SiteHeader active="projects" client:load/><WorkDetail {detail} {project} client:load/></div>
</Layout>
